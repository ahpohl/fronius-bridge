# Copy to .env and adjust. POSTGRES_PASSWORD is the only required setting.
# Generate with:  tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
# Alphanumeric output is safe everywhere the value travels unquoted: this
# file, the compose interpolation and the libpq DSN of the bridge.
POSTGRES_PASSWORD=change-me

# Path to this site's bridge configuration. The default points at the
# example config docker/fronius-bridge/config.yaml, which talks to the
# bundled broker and database — good for a smoke test. A real deployment
# copies the example, adjusts site and devices, and sets the path here.
#FRONIUS_CONFIG=/path/to/your/config.yaml

# Pin the stack to a released version instead of following latest. Both the
# bridge and the database image move together under one version.
#FRONIUS_VERSION=latest

# Database name and role, synchronised between the containers: consumed by
# the database container's first boot (initdb) and by the ${VAR} references
# in the bridge's postgres DSN.
#POSTGRES_DB=fronius
#POSTGRES_USER=postgres

# Local timezone of the database container. Governs when the pg_cron rollup
# jobs fire and the wall-clock day boundary of the site rollup.
#TZ=Europe/Berlin
